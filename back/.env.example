# Copie para .env. Nunca publique o arquivo .env no GitHub.
PORT=3000
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/stok
JWT_SECRET=COLOQUE_UMA_CHAVE_LONGA_E_ALEATORIA
JWT_EXPIRES_IN=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@stok.local
ADMIN_PASSWORD=TroqueEstaSenha123!

# Configuração de envio de e-mail (SMTP). Exemplo: Gmail com senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=SENHA_DE_APP_DO_EMAIL
SMTP_FROM=STOK <seuemail@gmail.com>
# URL pública do front (necessária para links de recuperação de senha)
FRONT_URL=http://localhost:5500
